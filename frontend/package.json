{
  "name": "voices-of-heritage-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k \"npm:dev\" \"npm:ai:dev\"",
    "ai:install": "cd ../components/Voices-of-Heritage-ai-trip-planner && npm run install-all",
    "ai:server": "cd ../components/Voices-of-Heritage-ai-trip-planner/server && PORT=5002 npm run dev",
    "ai:client": "cd ../components/Voices-of-Heritage-ai-trip-planner/client && PORT=3001 BROWSER=none DANGEROUSLY_DISABLE_HOST_CHECK=true REACT_APP_API_URL=http://localhost:5002/api npm start",
    "ai:dev": "concurrently -k \"npm:ai:server\" \"npm:ai:client\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "echo 'No lint configuration found'",
    "test": "echo 'No tests configured' && exit 0"
  },
  "dependencies": {
    "@photo-sphere-viewer/core": "^5.14.1",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.1",
    "axios": "^1.7.9",
    "firebase": "^11.10.0",
    "framer-motion": "^10.16.16",
    "html5-qrcode": "^2.3.8",
    "js-cookie": "^3.0.5",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.12.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.17.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
