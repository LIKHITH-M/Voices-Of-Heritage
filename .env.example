# =============================================================
# VOICES OF HERITAGE — Environment Variables Template
# Copy this file to .env and fill in all required values.
# NEVER commit the .env file to version control.
# =============================================================

# ---------------------------
# Application
# ---------------------------
NODE_ENV=development
APP_PORT=3000
API_GATEWAY_URL=http://localhost:8080

# ---------------------------
# Frontend (Next.js)
# ---------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ---------------------------
# Auth Service
# ---------------------------
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ---------------------------
# Databases
# ---------------------------
# PostgreSQL (relational data)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voices_heritage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# MongoDB (documents, archives)
MONGO_URI=mongodb://localhost:27017/voices_heritage

# Redis (caching, sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ---------------------------
# AI / ML Services
# ---------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ---------------------------
# Real-Time (WebRTC)
# ---------------------------
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

# ---------------------------
# Blockchain
# ---------------------------
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_infura_key
PRIVATE_KEY=your_wallet_private_key_here
CONTRACT_ADDRESS=deployed_contract_address_here

# ---------------------------
# Weather API
# ---------------------------
OPENWEATHER_API_KEY=your_openweathermap_api_key

# ---------------------------
# News API
# ---------------------------
NEWS_API_KEY=your_newsapi_key_here

# ---------------------------
# Payments (Cashfree & Razorpay)
# ---------------------------
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# ---------------------------
# Email (SMTP)
# ---------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL=noreply@voicesofheritage.in

# ---------------------------
# Storage (S3-compatible)
# ---------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=voices-of-heritage-assets

# ---------------------------
# UNESCO / ASI APIs
# ---------------------------
UNESCO_API_KEY=your_unesco_api_key
ASI_API_KEY=your_asi_api_key

# ---------------------------
# Tourism Board APIs
# ---------------------------
TOURISM_BOARD_API_KEY=your_tourism_board_api_key
TOURISM_BOARD_BASE_URL=https://api.incredibleindia.org

# ---------------------------
# Monitoring
# ---------------------------
SENTRY_DSN=your_sentry_dsn_here
