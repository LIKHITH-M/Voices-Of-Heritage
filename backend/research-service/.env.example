# research-service environment variables
# Copy this to .env and fill in values

# Server
RESEARCH_SERVICE_PORT=5003
NODE_ENV=development

# MongoDB (shared with ai-planner-service)
MONGO_URI=mongodb://localhost:27017/voices_heritage

# Frontend URL (for CORS)
VITE_FRONTEND_URL=http://localhost:3000

# AI Planner service URL (for internal calls)
AI_PLANNER_SERVICE_URL=http://localhost:5002

# Auth Service URL (for token validation)
AUTH_SERVICE_URL=http://localhost:4001

# Optional: Vector DB for RAG (Phase 12)
# CHROMADB_URL=http://localhost:8000

# Optional: Embedding model API key (Phase 12)
# GEMINI_API_KEY=your_gemini_api_key_here

